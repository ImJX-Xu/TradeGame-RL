flowchart TB
    classDef input fill:#EAF8F2,stroke:#16805C,stroke-width:1.5px,color:#173B2E
    classDef network fill:#FFF7E6,stroke:#D97706,stroke-width:1.5px,color:#451A03
    classDef decision fill:#F4EDFF,stroke:#7C3AED,stroke-width:1.5px,color:#2E1065
    classDef output fill:#FFF1E8,stroke:#EA580C,stroke-width:1.5px,color:#431407

    encoding["StateEncoding<br/>state [B,128] 与商品、路线候选"]:::input
    masks["ActionMaskBatch<br/>合法操作与参数范围"]:::input

    value["价值头<br/>128 -> 128 -> 1"]:::network
    action_type["操作类型头<br/>128 -> 128 -> 8"]:::network
    products["买入 / 卖出商品头<br/>state + 商品候选 -> [B,P]"]:::network
    quantities["数量头<br/>state + 商品候选 + 数量语义<br/>-> [B,P,21]"]:::network
    travel["旅行头<br/>state + 城市 / 运输 / 加急候选"]:::network
    finance["融资与购车数量头<br/>state + 数量语义 -> [B,21]"]:::network

    sample["条件采样与联合 log_prob<br/>ActionBatch [B,6]"]:::decision
    command["ActionHead -> 核心 Command"]:::output

    encoding --> value
    encoding --> action_type
    encoding --> products
    encoding --> quantities
    encoding --> travel
    encoding --> finance
    action_type --> sample
    products --> sample
    quantities --> sample
    travel --> sample
    finance --> sample
    masks --> sample
    sample --> command
