flowchart TB
    classDef source fill:#EAF8F2,stroke:#16805C,stroke-width:1.5px,color:#173B2E
    classDef encoder fill:#EAF1FF,stroke:#2563EB,stroke-width:1.5px,color:#172554
    classDef relation fill:#F4EDFF,stroke:#7C3AED,stroke-width:1.5px,color:#2E1065
    classDef output fill:#FFF1E8,stroke:#EA580C,stroke-width:1.5px,color:#431407

    facts["G / X / C / P / M / R / L<br/>公开经营事实矩阵"]:::source
    row_encoders["数值行编码器<br/>各类事实行 -> 64 维"]:::encoder
    global_context["当前位置 + 全局经营状态<br/>global_context [B,64]"]:::encoder
    purchase["采购候选<br/>商品 x 目的地 x 运输方式"]:::relation
    cargo["库存候选<br/>批次 x 目的地 x 运输方式"]:::relation
    aggregate["有效候选行的均值 + 最大值汇聚<br/>商品、城市、运输方案上下文"]:::relation
    tokens["product_tokens [B,P,64]<br/>route_city_tokens [B,C,64]<br/>route_mode_tokens [B,C,T,64]<br/>route_option_tokens [B,C,T,2,64]"]:::output
    state["state [B,128]"]:::output

    facts --> row_encoders
    row_encoders --> global_context
    row_encoders --> purchase
    row_encoders --> cargo
    purchase --> aggregate
    cargo --> aggregate
    aggregate --> tokens
    global_context --> state
    tokens --> state
